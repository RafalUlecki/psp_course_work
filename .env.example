# Copy to `.env` in the repo root (`cp .env.example .env`).
# Docker Compose reads this file. Do not commit `.env`.

# Postgres container (must match the credentials in DATABASE_URL)
POSTGRES_USER=prophover
POSTGRES_PASSWORD=prophover
POSTGRES_DB=prophover

# App → Postgres. Host `postgres` is the Compose service name.
# For `npm run dev` on the host, use localhost in apps/web/.env instead.
DATABASE_URL=postgresql://prophover:prophover@postgres:5432/prophover

# Auth token lifetime in days. Missing falls back to 14. Non-number or < 1 fails startup.
AUTH_TOKEN_TTL_DAYS=14

# Require Bearer tokens on private /api routes (default true). Login POST /api/auth/login is public.
AUTH_REQUIRED=true

# Public API base URL for browser requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
