# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# NextAuth secret — later
# NEXTAUTH_SECRET=""

# Public API base URL for browser requests
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Auth token lifetime in days. Missing falls back to 14. Non-number or < 1 fails startup.
AUTH_TOKEN_TTL_DAYS=14

# Require Bearer tokens on private /api routes (default true). Login POST /api/auth/login is public.
# Set false to keep the pre-auth X-Client-Id behaviour until the extension sign-in flow (PH-44).
AUTH_REQUIRED=true

