generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Venue {
  home
  away
}

model Player {
  id             Int             @id
  name           String          @unique
  team           String?
  gameLogs       GameLog[]
  watchlistItems WatchlistItem[]

  @@map("players")
}

model Client {
  id             String          @id
  name           String
  watchlistItems WatchlistItem[]

  @@map("clients")
}

model WatchlistItem {
  id       Int    @id @default(autoincrement())
  clientId String @map("client_id")
  playerId Int    @map("player_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([clientId, playerId])
  @@index([clientId])
  @@map("watchlist_items")
}

model GameLog {
  id           Int      @id @default(autoincrement())
  playerId     Int      @map("player_id")
  gameDate     DateTime @map("game_date") @db.Date
  opponent     String
  venue        Venue
  pts          Int
  reb          Int
  ast          Int
  source       String
  sourceGameId String   @map("source_game_id")
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, source, sourceGameId])
  @@index([playerId, gameDate])
  @@map("game_logs")
}
