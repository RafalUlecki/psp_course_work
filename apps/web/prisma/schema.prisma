generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Venue {
  home
  away
}

model Player {
  id       Int       @id
  name     String    @unique
  team     String?
  gameLogs GameLog[]

  @@map("players")
}

model GameLog {
  id           Int      @id @default(autoincrement())
  playerId     Int      @map("player_id")
  gameDate     DateTime @map("game_date") @db.Date
  opponent     String
  venue        Venue
  pts          Int
  reb          Int
  ast          Int
  source       String
  sourceGameId String   @map("source_game_id")
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, source, sourceGameId])
  @@index([playerId, gameDate])
  @@map("game_logs")
}
