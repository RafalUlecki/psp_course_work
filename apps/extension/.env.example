# Hit-rate API origin baked into the content script at `npm run build`.
# Local dev: same value as NEXT_PUBLIC_API_BASE_URL in apps/web/.env.example.
# Same-origin fixture only: leave empty (relative /api/hit-rate).
# Packaged / hosted API: set the hosted origin (must also replace the
# YOUR_HOSTED_API_ORIGIN.example placeholder in manifest.src.json).
VITE_HIT_RATE_API_BASE="http://localhost:3000"
